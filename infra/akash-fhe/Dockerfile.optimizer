FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends binutils && rm -rf /var/lib/apt/lists/*

# CPU-only image for Phase 1 HybridFHEModel validation (smaller, faster deploy).
# GPU/CUDA variant will be re-added when scaling to GLM-4-9B/32B.
pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
torch==2.3.1+cpu && \
pip install --no-cache-dir \
    concrete-ml==1.9.0 \
    transformers \
    safetensors \
    huggingface-hub \
    fastapi \
    uvicorn \
    python-multipart

RUN pip install --no-cache-dir "setuptools<81" && \
    python -c "import pkg_resources; print('pkg_resources OK')"

ARG CACHE_BUST=1
COPY optimizer.py /app/optimizer.py
COPY optimizer_hybrid.py /app/optimizer_hybrid.py

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "optimizer_hybrid:app", "--host", "0.0.0.0", "--port", "8080"]
