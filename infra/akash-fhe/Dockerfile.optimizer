FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends binutils && rm -rf /var/lib/apt/lists/*

# Use CPU PyTorch and concrete-ml's CPU concrete-python to keep the image small
# enough to pull on Akash providers. The SDL still requests an H100 GPU so the pod
# is GPU-enabled; switching to GPU concrete-python is a future image-only change.
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
torch==2.3.1+cpu && \
    pip install --no-cache-dir \
    concrete-ml==1.9.0 \
    transformers \
    safetensors \
    huggingface-hub \
    fastapi \
    uvicorn \
    python-multipart

RUN pip install --no-cache-dir "setuptools<81" && \
    python -c "import pkg_resources; print('pkg_resources OK')"

ARG CACHE_BUST=1
COPY optimizer.py /app/optimizer.py
COPY optimizer_hybrid.py /app/optimizer_hybrid.py

EXPOSE 8080

CMD ["python", "-m", "uvicorn", "optimizer_hybrid:app", "--host", "0.0.0.0", "--port", "8080"]
